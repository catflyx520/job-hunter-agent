# 复制成 .env 后填写。.env 不会进 git。

# 加密 API key 用的 Fernet 金钥（必填才能保存 API key）
# 产生方式：cd backend && uv run python -m app.core.security
APP_SECRET_KEY=

# docker 里的 Postgres（docker compose up -d）
DATABASE_URL=postgresql+psycopg://jobhunter:jobhunter@localhost:5433/jobhunter

# embedding 向量维度：text-embedding-3-small = 1536；nomic-embed-text (Ollama) = 768
# 第一次 migration 之前决定；之后要改需重建 experience_chunks
EMBEDDING_DIM=1536

# 本机 CLI provider（claude / codex）
CLI_TIMEOUT_SECONDS=180
CLI_MAX_CONCURRENCY=2
